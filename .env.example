
# Copy to .env and fill in your own values:  cp .env.example .env
# .env is gitignored — never commit real credentials.

export SNOWFLAKE_ACCOUNT="<orgname>-<account_name>"
export SNOWFLAKE_USER="<your_snowflake_user>"
export SNOWFLAKE_ROLE="<your_role>"
export SNOWFLAKE_WAREHOUSE="<your_warehouse>"
export SNOWFLAKE_DATABASE="<your_database>"

# Personal dev schema so your builds don't collide with anyone else's.
export SNOWFLAKE_SCHEMA="dbt_<yourname>"

# Only needed if using password auth instead of SSO.
export SNOWFLAKE_PASSWORD="<your_snowflake_password>"

# Salt for hashing PII columns — see dbt/macros/mask_pii.sql.
#
# This is what makes host_name_masked irreversible: without a secret salt, a
# first name is recovered by hashing a name list and matching. macros/mask_pii.sql
# has a non-secret default so a fresh clone builds, but any environment where the
# masking has to actually hold must set a real value here.
#
# Treat it like a credential. Everyone sharing a warehouse needs the SAME value —
# changing it changes every hash, so masked columns stop joining across
# environments built with different salts.
export PII_HASH_SALT="<a_long_random_secret>"
